{
  "id": "./",
  "name": "Nexus Live Web Canvas & PWA",
  "short_name": "NexusApp",
  "description": "Progressive Web Application built with Nexus AI",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#020617",
